---
import { VOORZIENINGEN } from '../consts';
---

<section id="voorzieningen" class="bg-lilac-100 py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-semibold text-ink-900 sm:text-4xl">Wat vind je bij Verano Ice Bar?</h2>
    <dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        VOORZIENINGEN.map((v) => (
          <div class="border-t-2 border-lilac-500/40 pt-4">
            <dt class="font-display text-xl font-semibold text-ink-900">{v.label}</dt>
            <dd class="mt-1 text-ink-700">{v.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
