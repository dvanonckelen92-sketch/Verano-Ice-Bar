---
export type FaqItem = { question: string; answer: string };

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section id="vragen" class="py-16">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <h2 class="text-3xl font-semibold text-ink-900 sm:text-4xl">Veelgestelde vragen</h2>
    <div class="mt-6 divide-y divide-sun-200">
      {
        items.map((item) => (
          <div class="py-5">
            <h3 class="text-xl font-semibold text-ink-900">{item.question}</h3>
            <p class="mt-2 text-ink-700">{item.answer}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
