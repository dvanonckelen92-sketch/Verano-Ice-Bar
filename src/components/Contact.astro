---
import { SITE, BUSINESS, LINKS } from '../consts';
---

<section id="contact" class="bg-white py-16">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 md:grid-cols-2">
    <div>
      <h2 class="text-3xl font-semibold text-ink-900 sm:text-4xl">Waar vind je Verano Ice Bar?</h2>
      <p class="mt-3 text-ink-700">
        Verano Ice Bar ligt op de {BUSINESS.streetAddress} in {BUSINESS.postalCode} {BUSINESS.addressLocality}. Je kan er met de fiets of de auto terecht.
      </p>
      <address class="mt-6 not-italic leading-relaxed">
        <strong class="text-ink-900">{SITE.name}</strong><br />
        {BUSINESS.streetAddress}<br />
        {BUSINESS.postalCode} {BUSINESS.addressLocality}<br />
        <a href={BUSINESS.phoneHref} class="font-bold text-berry-700 underline">{BUSINESS.phone}</a><br />
        <a href={`mailto:${BUSINESS.email}`} class="font-bold text-berry-700 underline">{BUSINESS.email}</a>
      </address>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={LINKS.route} target="_blank" rel="noopener" class="rounded-full bg-ink-900 px-6 py-3 font-bold text-sun-100 hover:bg-ink-700">
          Plan je route
        </a>
        <a href={LINKS.facebook} target="_blank" rel="noopener" class="rounded-full border-2 border-ink-900 px-5 py-2.5 font-bold text-ink-900 hover:bg-sun-100">
          Facebook
        </a>
        <a href={LINKS.instagram} target="_blank" rel="noopener" class="rounded-full border-2 border-ink-900 px-5 py-2.5 font-bold text-ink-900 hover:bg-sun-100">
          Instagram
        </a>
      </div>
    </div>

    <div class="min-h-72 overflow-hidden rounded-3xl bg-sun-100 shadow-sm">
      <iframe
        src={LINKS.mapsEmbed}
        class="h-full min-h-72 w-full"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Kaart met de ligging van ${SITE.name} in ${BUSINESS.addressLocality}`}
      ></iframe>
    </div>
  </div>
</section>
