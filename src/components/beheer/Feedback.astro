---
// Melding in een blok van /beheer: groen na opslaan, rood bij een fout.
interface Props {
  result: { ok: boolean; text: string } | null;
  class?: string;
}

const { result, class: className } = Astro.props;
---

{
  result && (
    <p
      data-feedback
      role={result.ok ? 'status' : 'alert'}
      class:list={[
        'rounded-xl px-4 py-2.5 text-[15px] font-bold',
        result.ok ? 'bg-mint-100 text-mint-600' : 'bg-berry-100 text-berry-700',
        className,
      ]}
    >
      {result.ok ? '✓ ' : ''}
      {result.text}
    </p>
  )
}
