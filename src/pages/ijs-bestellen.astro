---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, BUSINESS, LITERS } from '../consts';

// Statisch, zodat Netlify Forms het formulier bij de deploy herkent.
// Aanvragen komen binnen in Netlify onder Forms > liters-ijs; zet daar een
// e-mailmelding naar het adres van de zaak.
const FORM_NAME = 'liters-ijs';


const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Liters ijs bestellen', item: `${SITE.url}/ijs-bestellen` },
    ],
  },
  {
    '@type': 'Service',
    name: 'Liters ijs bestellen',
    serviceType: 'IJs per liter op bestelling',
    provider: { '@id': `${SITE.url}/#zaak` },
    areaServed: { '@type': 'City', name: BUSINESS.addressLocality },
  },
];

const fieldClass =
  'mt-1.5 block w-full rounded-xl border-2 border-sun-200 bg-white px-4 py-3 text-base text-ink-900 focus:border-ink-800 focus:outline-none';
const labelClass = 'block font-bold text-ink-900';
---

<Layout
  title="Liters ijs bestellen in Alken | Verano Ice Bar"
  description="Liters ijs bestellen in Alken voor een feest of voor thuis. Kies je smaken, vraag je bestelling aan bij Verano Ice Bar en haal ze vers af aan de toonbank."
  schema={schema}
>
  <Header />
  <main>
    <section class="bg-sun-300">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
        <nav aria-label="Kruimelpad" class="text-sm font-semibold text-ink-700">
          <a href="/" class="underline hover:text-berry-700">Home</a> <span aria-hidden="true">/</span> Liters ijs bestellen
        </nav>
        <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight text-ink-900 sm:text-5xl">Liters ijs bestellen in Alken</h1>
        <p class="mt-4 max-w-2xl text-lg text-ink-800">
          Liters ijs bestellen doe je bij Verano Ice Bar voor een verjaardag, een communiefeest, een barbecue of gewoon voor
          in je eigen diepvries. Je kiest zelf de smaken, wij draaien ze vers en je haalt ze af in onze ijssalon op de
          {' '}{BUSINESS.streetAddress}.
        </p>
      </div>
    </section>

    <section class="py-14">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_1.2fr]">
        <div>
          <h2 class="text-3xl font-semibold text-ink-900">Hoe bestel je liters ijs?</h2>
          <ol class="mt-5 space-y-4 text-ink-800">
            <li>
              <strong class="text-ink-900">1. Vul het formulier in.</strong> Kies het formaat, het aantal en de smaken, en wanneer je
              het ijs wil afhalen. Bestel minstens {LITERS.leadDays} dagen op voorhand, zo kunnen we je smaken vers draaien.
            </li>
            <li>
              <strong class="text-ink-900">2. Wij bevestigen.</strong> We bellen of mailen je terug met de prijs en het afhaalmoment.
              Pas dan is je bestelling vast.
            </li>
            <li>
              <strong class="text-ink-900">3. Afhalen in Alken.</strong> Je haalt je ijs af aan de toonbank op de
              {' '}{BUSINESS.streetAddress}. Neem een koeltas mee als je verder moet rijden.
            </li>
          </ol>
          <p class="mt-6 text-ink-700">
            Liever even bellen? Dat kan op <a href={BUSINESS.phoneHref} class="font-bold text-berry-700 underline">{BUSINESS.phone}</a>.
            Benieuwd wat er nu in de toonbank ligt? Bekijk de <a href="/#smaken" class="font-bold text-berry-700 underline">smaken van vandaag</a>.
          </p>
        </div>

        <form
          name={FORM_NAME}
          method="POST"
          action="/ijs-bestellen/bedankt"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="rounded-3xl bg-white p-6 shadow-sm sm:p-8"
        >
          <input type="hidden" name="form-name" value={FORM_NAME} />
          <p class="hidden">
            <label>Niet invullen: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <h2 class="text-2xl font-semibold text-ink-900">Je aanvraag</h2>

          <div class="mt-5 grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="naam" class={labelClass}>Naam</label>
              <input id="naam" name="naam" required autocomplete="name" class={fieldClass} />
            </div>
            <div>
              <label for="telefoon" class={labelClass}>Telefoon</label>
              <input id="telefoon" name="telefoon" type="tel" required autocomplete="tel" class={fieldClass} />
            </div>
            <div>
              <label for="email" class={labelClass}>E-mail <span class="font-normal text-ink-700">(optioneel)</span></label>
              <input id="email" name="email" type="email" autocomplete="email" class={fieldClass} />
            </div>
            <div>
              <label for="formaat" class={labelClass}>Formaat</label>
              <select id="formaat" name="formaat" required class={fieldClass}>
                {LITERS.sizes.map((size) => <option>{size}</option>)}
              </select>
            </div>
            <div>
              <label for="aantal" class={labelClass}>Aantal potten</label>
              <input id="aantal" name="aantal" type="number" min="1" max="50" value="1" required class={fieldClass} />
            </div>
            <div class="sm:col-span-2">
              <label for="smaken" class={labelClass}>Welke smaken?</label>
              <textarea
                id="smaken"
                name="smaken"
                rows="3"
                required
                placeholder="Bijvoorbeeld: 1 liter vanille, 1 liter aardbei sorbet"
                class={fieldClass}></textarea>
            </div>
            <div>
              <label for="afhaaldatum" class={labelClass}>Afhalen op</label>
              <input id="afhaaldatum" name="afhaaldatum" type="date" required class={fieldClass} data-lead-days={LITERS.leadDays} />
            </div>
            <div>
              <label for="afhaaluur" class={labelClass}>Rond welk uur?</label>
              <input id="afhaaluur" name="afhaaluur" type="time" min="13:00" max="21:00" class={fieldClass} />
            </div>
            <div class="sm:col-span-2">
              <label for="opmerking" class={labelClass}>Opmerking <span class="font-normal text-ink-700">(optioneel)</span></label>
              <textarea id="opmerking" name="opmerking" rows="2" class={fieldClass}></textarea>
            </div>
            <div class="sm:col-span-2">
              <label class="flex items-start gap-3 text-ink-800">
                <input type="checkbox" name="privacy" value="akkoord" required class="mt-1 h-5 w-5 accent-ink-900" />
                <span>
                  Verano Ice Bar mag mijn gegevens gebruiken om deze bestelling af te handelen, zoals beschreven in het
                  {' '}<a href="/privacybeleid" class="font-bold underline">privacybeleid</a>.
                </span>
              </label>
            </div>
          </div>

          <button type="submit" class="mt-6 w-full rounded-full bg-ink-900 px-6 py-3.5 text-lg font-bold text-sun-100 hover:bg-ink-700">
            Verstuur mijn aanvraag
          </button>
          <p class="mt-3 text-center text-sm text-ink-700">Je aanvraag is pas definitief na onze bevestiging.</p>
        </form>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script>
  // Vroegste afhaaldatum = vandaag + het aantal dagen voorbereidingstijd.
  const input = document.getElementById('afhaaldatum') as HTMLInputElement | null;
  if (input) {
    const lead = Number(input.dataset.leadDays ?? 0);
    const d = new Date();
    d.setDate(d.getDate() + lead);
    input.min = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }
</script>
